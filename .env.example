# Turso Cloud (install the Turso integration from the Vercel Marketplace)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-your-turso-token

# Vercel Private Blob (create a private Blob store in this Vercel project)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# Élan signed session
ELAN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional display identities
ELAN_PATIENT_NAME=Salah
ELAN_PATIENT_EMAIL=salah@elan.local
ELAN_FAMILY_NAME=Sylvie
ELAN_FAMILY_EMAIL=sylvie@elan.local
ELAN_ADMIN_NAME=Équipe Élan
ELAN_ADMIN_EMAIL=admin@elan.local
